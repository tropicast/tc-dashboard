<Project Sdk="Microsoft.NET.Sdk">
  <!-- Adapters for the Application ports: EF Core, Identity, email, HTTP clients, background services. -->
  <ItemGroup>
    <ProjectReference Include="..\Tropicast.Dashboard.Application\Tropicast.Dashboard.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- Pinned with EF Core: Npgsql alone would resolve an older Relational. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="SSH.NET" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tropicast.Dashboard.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Tropicast.Dashboard.Api.IntegrationTests" />
  </ItemGroup>
</Project>
