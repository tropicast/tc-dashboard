<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: public XML docs are not required for an application. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Company>Tropicast</Company>
    <Product>Tropicast Dashboard</Product>
    <!-- Development placeholder: release builds take the version from the git tag (release.yml, Dockerfile VERSION). -->
    <Version>0.0.0</Version>
  </PropertyGroup>
</Project>
