# Copy to terraform.tfvars (git-ignored) and edit. In CI, the TFVARS
# repository variable holds the same content.
name        = "tc-app-1"
location    = "fsn1"
server_type = "cx23"

ssh_public_keys = {
  admin = "ssh-ed25519 AAAA... admin@example"
}
# A key already registered in the Hetzner project (e.g. by tc-streaming) cannot
# be registered again: reference it by name and drop it from ssh_public_keys.
# existing_ssh_key_names = ["tc-stream-1-admin"]

admin_cidrs = ["203.0.113.10/32"]

# Streaming nodes to attach to the private network (name => private IP).
streaming_nodes = { "tc-stream-1" = "10.20.1.2" }

# Cloudflare zone ID of tropicastradio.com (Overview page); null to manage DNS by hand.
cloudflare_zone_id = null
app_hostname       = "app.tropicastradio.com"
