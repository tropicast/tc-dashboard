# TLS gateway for the control plane (#15). Caddy is the only public entry
# point; the API stays on the internal Docker network.
{
	email {$ACME_EMAIL}
}

{$APP_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Nothing may be framed except the embeddable player (#12), whose
	# Content-Security-Policy frame-ancestors the API sets.
	@framed_never not path /embed/*
	header @framed_never X-Frame-Options DENY

	# Source auth and other internal endpoints are never public.
	@internal path /internal/*
	respond @internal 404

	reverse_proxy api:8080
}
